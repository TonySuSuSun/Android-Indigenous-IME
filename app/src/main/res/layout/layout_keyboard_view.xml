<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_gravity="center_horizontal|bottom">

    <LinearLayout
        android:id="@+id/candidateBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyboard_key_size"
        android:orientation="horizontal"
        android:background="?android:attr/colorBackground"
        android:visibility="visible">

        <TextView
            android:id="@+id/candidate1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="@dimen/keyboard_view_key_text_size"
            android:textColor="?android:attr/textColorSecondary"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/keyboard_view_padding" />

        <TextView
            android:id="@+id/candidate2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="@dimen/keyboard_view_key_text_size"
            android:textColor="?android:attr/textColorSecondary"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/keyboard_view_padding" />

        <TextView
            android:id="@+id/candidate3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="@dimen/keyboard_view_key_text_size"
            android:textColor="?android:attr/textColorSecondary"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/keyboard_view_padding" />

    </LinearLayout>

    <com.litekite.ime.widget.KeyboardView
        android:id="@+id/v_keyboard"
        style="@style/KeyboardStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:focusable="true"
        android:padding="@dimen/keyboard_view_padding"
        android:paddingTop="@dimen/keyboard_view_root_padding_top"
        tools:ignore="SpeakableTextPresentCheck" />

</LinearLayout>
