<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Keyboard Style [IME] -->
    <style name="KeyboardStyle">
        <item name="fontFamily">sans-serif</item>
        <item name="textStyle">normal</item>
        <item name="useKeyPreview">true</item>
        <item name="android:background">@null</item>
        <item name="android:longClickable">true</item>
        <item name="labelTextSize">@dimen/keyboard_view_key_text_size</item>
        <item name="keyTextColorPrimary">?android:textColorPrimary</item>
        <item name="keyTextColorSecondary">?android:textColorSecondary</item>
        <item name="keyBackground">@drawable/bg_keyboard_key</item>
    </style>

    <style name="KeyPopupTextViewStyle" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">@dimen/keyboard_view_key_text_size</item>
        <item name="android:background">@null</item>
    </style>

</resources>
